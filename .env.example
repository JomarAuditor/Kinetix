# Copy this file to ".env" and paste your own keys after the equals sign.
# Do not share your .env file or upload it to GitHub.

# Free key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Free key from https://console.cloud.google.com/apis/credentials
# Enable YouTube Data API v3 for your project
YOUTUBE_API_KEY=

# Optional: shortest YouTube upload (minutes) that counts as a full-length movie. Default 60.
MOVIE_MIN_DURATION_MINUTES=
